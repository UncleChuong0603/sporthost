# Single Dokploy Application: sporthost-production. Runtime values only.
# Set real existing credentials directly in Dokploy. Blanks below are NOT deploy-ready.
APP_ENV=production
PORT=8000
APP_URL=https://sporthost.online
ALLOWED_HOSTS=sporthost.online,www.sporthost.online,localhost,127.0.0.1
# Add the actual temporary Dokploy hostname to ALLOWED_HOSTS before preview.
# Keep true until the owner approves enabling production writes at cutover.
APP_READ_ONLY=true
COOKIE_SECURE=true
DB_SCHEMA=clubhost
DATABASE_URL=
SECRET_KEY=
# Retain the SAME existing private Vercel Blob store. No local volume needed for Blob.
STORAGE_BACKEND=blob
BLOB_READ_WRITE_TOKEN=
# Set only after inspecting the existing Traefik-to-application source network.
FORWARDED_ALLOW_IPS=
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=
# RESEND_API_KEY intentionally omitted until the owner provides it.
ADMIN_EMAILS=
PLATFORM_TRIAL_DAYS=30
PLATFORM_CLUB_MONTHLY_VND=99000
