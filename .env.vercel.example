# Set these in Vercel Project > Settings > Environment Variables.
# Use a dedicated beta PostgreSQL database, with the provider's pooled TLS URL.
APP_ENV=staging
DATABASE_URL=postgresql://sporthost_app:REPLACE@YOUR_POOLED_HOST/YOUR_BETA_DATABASE?sslmode=require
DB_SCHEMA=clubhost
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
# Local-only migration credentials: use the direct endpoint if available.
# Never add DATABASE_MIGRATION_URL to the Vercel runtime environment.
# DATABASE_MIGRATION_URL=postgresql://OWNER:REPLACE@YOUR_DIRECT_HOST/YOUR_BETA_DATABASE?sslmode=require
