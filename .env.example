# Staging / production: use PostgreSQL only. Do not commit real .env files.
APP_ENV=development
# PostgreSQL example ONLY. Local port 55432 must be forwarded with SSH -L.
# DATABASE_URL=postgresql+psycopg://clubhost_app:REPLACE@127.0.0.1:55432/EXISTING_DATABASE
DATABASE_URL=sqlite:///./sporthost.db
DB_SCHEMA=clubhost
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
