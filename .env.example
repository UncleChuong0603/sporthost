# Staging / production: use PostgreSQL only. Do not commit real .env files.
APP_ENV=development
# PostgreSQL example ONLY. Local port 55432 must be forwarded with SSH -L.
# DATABASE_URL=postgresql+psycopg://clubhost_app:REPLACE@127.0.0.1:55432/EXISTING_DATABASE
DATABASE_URL=sqlite:///./sporthost.db
DB_SCHEMA=clubhost
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
PUBLIC_BASE_URL=http://127.0.0.1:8000
ADMIN_EMAILS=
# Dokploy: APP_ENV=production, COOKIE_SECURE=true, existing PostgreSQL/SECRET_KEY.
# APP_URL=https://sporthost.online
# ALLOWED_HOSTS=sporthost.online,www.sporthost.online,localhost,127.0.0.1
PORT=8000
# Dokploy temporary production preview: true until approved cutover (blocks writes).
APP_READ_ONLY=false
# Set to the verified Traefik source IP/CIDR, never trust arbitrary public senders.
# FORWARDED_ALLOW_IPS=
# Keep the existing PRIVATE Blob store at cutover. Set its token in Dokploy only.
STORAGE_BACKEND=auto
# BLOB_READ_WRITE_TOKEN=
# Optional only after verified media sync: STORAGE_BACKEND=local and persistent mount.
# STORAGE_ROOT=/data/uploads
EMAIL_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=
# Internal display only; no automatic software payment gateway.
PLATFORM_TRIAL_DAYS=30
PLATFORM_CLUB_MONTHLY_VND=99000
