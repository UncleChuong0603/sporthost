APP_ENV=development
APP_URL=http://127.0.0.1:3000
ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql://sporthost:replace-me@127.0.0.1:5432/sporthost_test
DB_SCHEMA=clubhost
SECRET_KEY=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
APP_READ_ONLY=false
DATABASE_POOL_MAX=5
STORAGE_ROOT=/data/uploads
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional absolute PEM path for a private SMTP certificate authority; TLS verification stays enabled.
SMTP_TLS_CA_FILE=
EMAIL_FROM=
# Optional: with SMTP_HOST=smtp.resend.com and SMTP_USER=resend, used as SMTP password.
# Sending still requires EMAIL_ENABLED=true and a verified EMAIL_FROM.
RESEND_API_KEY=
# Server-only payOS credentials. Never prefix with NEXT_PUBLIC_.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
